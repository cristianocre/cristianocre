# Variáveis do site. Copie para .env local, e cadastre as mesmas na Vercel
# em Settings > Environment Variables. O .env real nunca vai para o git.

# ---- Notion (captação de leads) — já em uso
NOTION_TOKEN=
NOTION_DATABASE_ID=

# ---- Meta / API de Conversões
# Token: Gerenciador de Eventos > seu pixel > Configurações > "Gerar token de acesso".
# É um token de sistema, não expira sozinho. Trate como senha.
META_CAPI_TOKEN=

# Opcional. Só preencha se o pixel do site mudar; o padrão já é o pixel atual.
META_PIXEL_ID=942431053282816

# Opcional. Cole aqui o código de "Testar eventos" do Gerenciador para validar a
# integração sem sujar os dados de produção. APAGUE depois de validar: enquanto
# estiver preenchido, os eventos entram como teste e NÃO contam para as campanhas.
META_TEST_EVENT_CODE=

# Opcional. Default v21.0.
META_API_VERSION=
